---
import { Image } from 'astro:assets';
import me from '../assets/abbe.jpg';
import Head from '../components/Head.astro';
import '../styles/global.css';

type Props = {
  title: string;
};

const { title } = Astro.props;
---

<!doctype html>
<html lang="en" class="motion-safe:scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <Head title={title} />
  </head>
  <body class="bg-blue-800">
    <nav class="sticky top-0 p-4 z-10">
      <a href="/">
        <Image
          src={me}
          alt="Abbe Keultjes"
          width={200}
          height={200}
          class="block size-26 saturate-120 rounded-full outline-8 outline-blue-700"
        />
      </a>
    </nav>
    <main>
      <slot />
    </main>
  </body>
</html>
