---
import { Image } from 'astro:assets';
import me from '../assets/abbe.jpg';
import Head from '../components/Head.astro';
import '../styles/global.css';

type Props = {
  title: string;
};

const { title } = Astro.props;
---

<!doctype html>
<html lang="en" class="motion-safe:scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <Head title={title} />
  </head>
  <body class="bg-blue-800">
    <nav class="fixed top-0 p-4 z-10 w-full">
      <div class="container mx-auto">
        <a href="/">
          <Image
            src={me}
            alt="Abbe Keultjes"
            priority
            layout="constrained"
            class="block size-26 saturate-120 rounded-full outline-8 outline-blue-800 md:size-40"
          />
        </a>
      </div>
    </nav>
    <main>
      <slot />
    </main>
  </body>
</html>
