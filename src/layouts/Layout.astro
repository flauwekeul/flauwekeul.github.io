---
import Head from '../components/Head.astro';

type Props = {
	title: string;
};

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<Head title={title} />
	</head>
	<body>
		<slot />
	</body>
</html>
