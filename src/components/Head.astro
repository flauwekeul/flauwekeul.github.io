---
import { Font } from 'astro:assets';

type Props = {
  title: string;
};

const { title } = Astro.props;
---

<Font cssVariable="--font-aleo" preload />
<Font cssVariable="--font-fira-sans" preload />
<!-- icon_names must be in alphabetical order and comma separated -->
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&icon_names=open_in_new"
/>
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<title>{title}</title>
