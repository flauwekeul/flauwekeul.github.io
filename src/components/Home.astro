---
import { Image } from 'astro:assets';
import family from '../assets/family.jpg';
import Heading from '../components/Heading.astro';
import Link from '../components/Link.astro';
import Paragraph from '../components/Paragraph.astro';
import { intercalate, shuffleArray, yearsSince } from '../utils';
import Tooltip from './Tooltip.astro';

const FEATURES = [
  { text: 'software engineer', href: '#software-engineer' },
  {
    text: 'aspiring functional programming guru',
    href: '#aspiring-functional-programming-guru',
  },
  { text: 'software educator' },
  { text: 'dad of three', href: '#dad-of-three' },
  { text: 'occasional cinephile' },
  { text: 'reader of books' },
  { text: 'listener of music' },
];
const START_OF_PROFESSIONAL_CAREER = new Date('2007-08-01');

const shuffledFeatures = shuffleArray(FEATURES);
const yearsOfProfessionalCareer = yearsSince(START_OF_PROFESSIONAL_CAREER);
---

<article>
  <div class="w-full bg-linear-to-b from-blue-800 to-indigo-900 pb-24">
    <section class="container mx-auto p-4 mb-48">
      <h1
        class="font-serif text-7xl font-bold mt-36 mb-16 text-yellow-300 text-shadow-lg sm:mt-56 sm:text-9xl md:text-[9rem] md:mb-36 xl:max-w-fit xl:mx-auto"
      >
        Abbe Keultjes
      </h1>
      <Paragraph variant="large" class="mx-auto">
        In no particular order:
        {
          intercalate(
            shuffledFeatures.map((feature) =>
              feature.href ? <Link href={feature.href}>{feature.text}</Link> : feature.text,
            ),
            ', ',
          )
        }.
      </Paragraph>
    </section>

    <section class="container mx-auto p-4 mb-24">
      <Heading id="software-engineer">Software engineer</Heading>
      <Paragraph>
        I’ve been writing software professionally for over
        <Tooltip
          content={`Since ${START_OF_PROFESSIONAL_CAREER.toLocaleDateString('en-UK', { year: 'numeric', month: 'long' })}`}
          ><time
            datetime={START_OF_PROFESSIONAL_CAREER.toISOString()}
            class="underline underline-offset-4 decoration-dotted">{yearsOfProfessionalCareer} years</time
          ></Tooltip
        >, with more than a decade focused on frontend development as a consultant. I have a keen eye for detail and
        take a thorough approach to both my code and the solutions I deliver. My primary languages are JavaScript and
        TypeScript.
      </Paragraph>
      <Paragraph>
        Nowadays I’m focussing more on software architecture, especially through a functional programming lens. I also
        enjoy coaching fellow programmers on coding, communication, and sharing knowledge effectively.
      </Paragraph>
    </section>

    <section class="container mx-auto p-4">
      <Heading id="aspiring-functional-programming-guru">Aspiring functional programming guru</Heading>
      <Paragraph>
        Code should be simple (<Link href="https://youtu.be/SxdOUGdseq4?si=uUW2jW2kYT_SDuYB" openInNewTab>not easy</Link
        >), maintainable, and communicate its intent clearly. That’s why I strongly prefer the functional programming
        paradigm: controlled side effects, immutable data, and functions as building blocks. This approach helps me
        build systems that are easier to reason about, test, and evolve over time.
      </Paragraph>
      <Paragraph>
        I’m drawn toward any language with a strong foundation in functional programming, but I have a soft spot for
        Clojure and its community.
      </Paragraph>
    </section>
  </div>

  <section
    class="relative pt-12 bg-slate-900 before:content-[''] before:absolute before:-top-[40px] before:left-0 before:w-0 before:h-0 before:border-t-40 before:border-t-transparent before:border-l-[100vw] before:border-l-slate-900 md:before:-top-[80px] md:before:border-t-80"
  >
    <div class="container mx-auto p-4">
      <Heading id="dad-of-three" variant="indigo">Dad of three</Heading>
    </div>
    <Image
      src={family}
      alt="Abbe Keultjes and his family"
      title="I’m the second from the right 😉"
      layout="full-width"
    />
  </section>
</article>
