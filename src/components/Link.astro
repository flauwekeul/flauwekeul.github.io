---
type Props = {
  href: string;
  openInNewTab?: boolean;
};

const { href, openInNewTab = false } = Astro.props;
const target = openInNewTab ? '_blank' : null;
const rel = openInNewTab ? 'noopener noreferrer' : null;
---

<a
  href={href}
  target={target}
  rel={rel}
  class="text-teal-200 underline underline-offset-3 transition-colors hover:text-teal-300"
  ><slot />{openInNewTab && <span class="ml-1 icon icon-rounded text-[90%] align-middle">open_in_new</span>}</a
>
