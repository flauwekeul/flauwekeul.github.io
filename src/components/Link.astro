---
type Props = {
  href: string;
  openInNewTab?: boolean;
};

const { href, openInNewTab = false } = Astro.props;
const target = openInNewTab ? '_blank' : null;
const rel = openInNewTab ? 'noopener noreferrer' : null;
---

<a href={href} target={target} rel={rel} class="text-yellow-300 underline underline-offset-2"
  ><slot />{
    openInNewTab && <span class="ml-1 icon icon-rounded text-[90%] align-middle text-yellow-300">open_in_new</span>
  }</a
>
