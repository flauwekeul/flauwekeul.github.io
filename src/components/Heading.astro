---
type Props = {
  id?: string;
  variant?: 'default' | 'indigo';
};

const { id, variant = 'default' } = Astro.props;

const baseClasses = 'font-serif text-4xl/tight font-bold mb-8 text-shadow-md md:text-6xl md:mb-12';
const variantClasses = {
  default: 'text-teal-100',
  indigo: 'text-indigo-400',
};
---

<h2 id={id} class:list={[baseClasses, variantClasses[variant]]}>
  <slot />
</h2>
